<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity
    version="0.4.1.0"
    processorArchitecture="*"
    name="Inkwell.Native"
    type="win32" />
  <description>Inkwell local Markdown editor</description>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="urn:schemas-microsoft-com:asm.v2">true/pm</dpiAware>
      <longPathAware xmlns="urn:schemas-microsoft-com:asm.v3">true</longPathAware>
    </windowsSettings>
  </application>
</assembly>
